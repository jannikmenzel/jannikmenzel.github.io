---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, t, getLocalizedPath, defaultLang, type Lang } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);

function localizedHref(href: string): string {
    return getLocalizedPath(lang, href);
}

const otherLang: Lang = lang === defaultLang ? "en" : "de";

const isNotFoundPage = Astro.url.pathname.replace(/\/+$/, "") === "/404";
const languageSwitchHref = getLocalizedPath(otherLang, isNotFoundPage ? "/" : Astro.url.pathname);

const socialLinks = [
    { icon: "lucide:linkedin", href: "https://linkedin.com/in/jannik-menzel", label: "LinkedIn" },
    { icon: "lucide:instagram", href: "https://instagram.com/jnk.mnz", label: "Instagram" },
    { icon: "lucide:github", href: "https://github.com/jannikmenzel", label: "GitHub" },
    { icon: "telegram", href: "https://t.me/jannikmenzel", label: "Telegram" },
];
---

<footer
    class="bg-darkAlt dark:bg-darkOff px-6 sm:px-8 py-10 sm:py-20 text-sm sm:text-base"
    role="contentinfo"
>
    <ul class="flex flex-wrap justify-center gap-4 sm:gap-10 list-none text-center">
        <li>
            <a
                href={localizedHref("/")}
                class="text-light text-sm sm:text-base underline hover:text-lightOff"
                >{t(lang, "nav.home")}</a
            >
        </li>
        <li>
            <a
                href={localizedHref("/blog/")}
                class="text-light text-sm sm:text-base underline hover:text-lightOff"
                >{t(lang, "nav.blog")}</a
            >
        </li>
        <li>
            <a
                href={localizedHref("/impressum/")}
                class="text-light text-sm sm:text-base underline hover:text-lightOff"
            >
                {t(lang, "nav.impressum")}
            </a>
        </li>
        <li>
            <a
                href={localizedHref("/datenschutz/")}
                class="text-light text-sm sm:text-base underline hover:text-lightOff"
            >
                {t(lang, "nav.datenschutz")}
            </a>
        </li>
    </ul>
    <div class="flex justify-center gap-6 my-8 sm:my-10">
        {
            socialLinks.map((link) => (
                <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    class="text-light transition-colors duration-200 hover:text-[#94a3b8]"
                >
                    {link.icon === "telegram" ? (
                        <svg
                            viewBox="0 0 24 24"
                            class="h-6 w-6 sm:h-7 sm:w-7"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M21.94 4.11c.27-1.02-.7-1.87-1.67-1.5L2.4 9.68c-1.05.4-1.03 1.9.03 2.27l4.4 1.52 1.7 5.46c.2.65 1.03.83 1.5.33l2.4-2.55 4.5 3.32c.8.6 1.96.16 2.16-.82L21.94 4.11ZM8.5 13.06l9.3-6.4c.2-.14.42.13.24.3l-7.72 7.1a1.1 1.1 0 0 0-.33.62l-.28 2.15-1.21-3.77Z" />
                        </svg>
                    ) : (
                        <Icon name={link.icon} class="h-6 w-6 sm:h-7 sm:w-7" />
                    )}
                </a>
            ))
        }
        <a
            href="#"
            id="footer-email-link"
            data-user="kontakt"
            data-domain="jannikmenzel.me"
            aria-label={t(lang, "accessibility.email")}
            class="text-light transition-colors duration-200 hover:text-[#94a3b8]"
        >
            <Icon name="lucide:mail" class="h-6 w-6 sm:h-7 sm:w-7" />
        </a>
    </div>
    <p class="text-lightOff text-center text-sm sm:text-base">
        &copy; Copyright {" "}
        <a
            href={localizedHref("/")}
            class="text-light text-sm sm:text-base underline hover:text-lightOff">Jannik Menzel</a
        >{" "}
        | {t(lang, "footer.copyright")} |
        <a
            href={languageSwitchHref}
            id="footer-language-switch"
            data-lang={otherLang}
            class="text-light text-sm sm:text-base underline hover:text-lightOff"
            >{t(lang, "footer.switchTo")} {otherLang === "en" ? "English" : "Deutsch"}</a
        >
    </p>
</footer>

<script is:inline>
    const footerEmailLink = document.getElementById("footer-email-link");
    if (footerEmailLink instanceof HTMLAnchorElement) {
        const user = footerEmailLink.dataset.user;
        const domain = footerEmailLink.dataset.domain;
        if (user && domain) {
            footerEmailLink.href = `mailto:${user}@${domain}`;
        }
    }

    const footerLanguageSwitch = document.getElementById("footer-language-switch");
    if (footerLanguageSwitch instanceof HTMLAnchorElement) {
        footerLanguageSwitch.addEventListener("click", () => {
            const newLang = footerLanguageSwitch.dataset.lang;
            if (newLang) {
                localStorage.setItem("language", newLang);
            }
        });
    }
</script>
