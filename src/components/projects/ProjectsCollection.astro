---
import {
    AppWindow,
    ArrowUpRight,
    Download,
    FileText,
    GraduationCap,
    Package,
    Scale,
    ShieldCheck,
    Terminal,
} from "@lucide/astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, t } from "../../i18n/ui";
import { openSourceProjects, type ProjectLinkKind } from "../../data/projects";
import ProjectPreview from "./ProjectPreview.astro";
import clearPage1 from "../../images/papers/clear-page-1.png";
import clearPage2 from "../../images/papers/clear-page-2.png";
import clearPage3 from "../../images/papers/clear-page-3.png";

const lang = getLangFromUrl(Astro.url);

const projectIcon: Record<string, typeof AppWindow> = {
    midnight: AppWindow,
    vortix: Terminal,
    sveltiaRbac: ShieldCheck,
};

const linkIcon: Record<ProjectLinkKind, typeof AppWindow> = {
    npm: Package,
    releases: Download,
};

const clearMetrics = [
    { label: "Macro-AUC", value: "0.9963" },
    { label: "Micro-AUC", value: "0.9981" },
    { label: "Micro-F1", value: "0.9556" },
];

const paperPageClass =
    "absolute inset-0 h-full w-full bg-white ring-1 ring-black/10 transition-transform duration-500 ease-out motion-reduce:transition-none";

const paperPages = [
    {
        src: clearPage3,
        alt: "",
        class: "shadow-md translate-x-[14%] -translate-y-[4%] rotate-[7deg] group-hover:translate-x-[18%] group-hover:-translate-y-[6%] group-hover:rotate-[10deg] group-focus-visible:translate-x-[18%] group-focus-visible:rotate-[10deg]",
        loading: "lazy",
    },
    {
        src: clearPage2,
        alt: "",
        class: "shadow-md -translate-x-[12%] translate-y-[2%] -rotate-[5deg] group-hover:-translate-x-[18%] group-hover:translate-y-[3%] group-hover:-rotate-[8deg] group-focus-visible:-translate-x-[18%] group-focus-visible:-rotate-[8deg]",
        loading: "lazy",
    },
    {
        src: clearPage1,
        alt: t(lang, "projects.paper.preview"),
        class: "shadow-xl group-hover:-translate-y-[3%] group-focus-visible:-translate-y-[3%]",
        loading: "eager",
    },
] as const;
---

<section class="w-full container" aria-labelledby="projects-heading">
    <header class="px-6 pt-16 sm:pt-20 text-center">
        <h1
            id="projects-heading"
            class="text-4xl font-black uppercase leading-[1.1] tracking-[-0.02em] text-background-foreground sm:text-5xl"
        >
            {t(lang, "projects.title")}
        </h1>
        <div class="mx-auto mt-4 h-1 w-24 bg-accent"></div>
        <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg text-muted-foreground">
            {t(lang, "projects.subtitle")}
        </p>
    </header>

    <!-- Papers -->
    <section class="px-6 pt-16 sm:pt-24" aria-labelledby="papers-heading">
        <div class="flex items-center gap-4 mb-8 sm:mb-10">
            <span class="font-mono text-xs text-muted-foreground">01</span>
            <h2
                id="papers-heading"
                class="text-2xl sm:text-3xl font-black uppercase tracking-[-0.02em] text-foreground"
            >
                {t(lang, "projects.papersHeading")}
            </h2>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <article
            class="scrolling-section grid grid-cols-1 lg:grid-cols-12 border border-border bg-backgroundAlt"
        >
            <a
                href="/papers/menzel-2026-introduction-to-clear.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="group relative flex items-center justify-center overflow-hidden border-b border-border bg-background px-6 py-12 sm:py-16 lg:col-span-5 lg:border-b-0 lg:border-r lg:py-20"
                aria-label={`${t(lang, "projects.paper.read")} (PDF)`}
            >
                <div class="relative w-44 sm:w-56 lg:w-64 aspect-[17/22]">
                    {
                        paperPages.map((page) => (
                            <Image
                                src={page.src}
                                alt={page.alt}
                                width={512}
                                widths={[256, 512]}
                                sizes="(min-width: 1024px) 16rem, (min-width: 640px) 14rem, 11rem"
                                class:list={[paperPageClass, page.class]}
                                loading={page.loading}
                            />
                        ))
                    }
                </div>
                <span
                    class="absolute bottom-4 right-4 inline-flex items-center gap-1.5 font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-muted-foreground transition-colors duration-200 group-hover:text-accent"
                    aria-hidden="true"
                >
                    PDF
                    <ArrowUpRight class="h-3.5 w-3.5" />
                </span>
            </a>

            <div class="p-5 sm:p-10 lg:col-span-7">
                <span
                    class="inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.25em] text-muted-foreground"
                >
                    <GraduationCap class="h-4 w-4 text-accent" aria-hidden="true" />
                    {t(lang, "projects.papers.clear.type")} / 2026
                </span>
                <h3
                    class="mt-4 font-display text-2xl sm:text-3xl font-bold leading-tight text-foreground"
                >
                    An Introduction to CLEAR for Multimodal Healthcare Analytics
                </h3>
                <p class="mt-3 text-sm text-muted-foreground">
                    {t(lang, "projects.papers.clear.venue")}
                </p>

                <h4 class="mt-8 text-[0.6875rem] uppercase tracking-[0.25em] text-muted-foreground">
                    {t(lang, "projects.paper.abstract")}
                </h4>
                <p class="mt-3 text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7">
                    {t(lang, "projects.papers.clear.abstract")}
                </p>

                <section class="mt-8" aria-labelledby="clear-reproduction-heading">
                    <h4
                        id="clear-reproduction-heading"
                        class="text-[0.6875rem] uppercase tracking-[0.25em] text-muted-foreground"
                    >
                        {t(lang, "projects.paper.reproduction")}
                    </h4>
                    <dl class="mt-3 grid grid-cols-3 border border-border bg-background">
                        {
                            clearMetrics.map((metric, i) => (
                                <div
                                    class:list={[
                                        "flex flex-col gap-1 p-3 sm:p-4",
                                        i > 0 && "border-l border-border",
                                    ]}
                                >
                                    <dt class="text-[0.625rem] uppercase tracking-[0.15em] text-muted-foreground sm:text-xs sm:tracking-[0.2em]">
                                        {metric.label}
                                    </dt>
                                    <dd class="font-mono text-lg font-bold text-foreground sm:text-2xl">
                                        {metric.value}
                                    </dd>
                                </div>
                            ))
                        }
                    </dl>
                </section>

                <div class="mt-8 sm:mt-10 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3">
                    <a
                        href="/papers/menzel-2026-introduction-to-clear.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary gap-2 whitespace-nowrap px-3! py-2.5! text-xs! no-underline sm:px-6! sm:py-3! sm:text-sm!"
                    >
                        <FileText class="hidden h-4 w-4 sm:block" aria-hidden="true" />
                        {t(lang, "projects.paper.read")}
                    </a>
                    <a
                        href="https://github.com/jannikmenzel/CLEAR"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary gap-2 whitespace-nowrap px-3! py-2.5! text-xs! no-underline sm:px-6! sm:py-3! sm:text-sm!"
                    >
                        <Icon
                            name="lucide:github"
                            class="hidden h-4 w-4 sm:block"
                            aria-hidden="true"
                        />
                        {t(lang, "projects.paper.code")}
                    </a>
                </div>
            </div>
        </article>
    </section>

    <!-- Open Source -->
    <section class="px-6 py-16 sm:py-24" aria-labelledby="open-source-heading">
        <div class="flex items-center gap-4 mb-8 sm:mb-10">
            <span class="font-mono text-xs text-muted-foreground">02</span>
            <h2
                id="open-source-heading"
                class="text-2xl sm:text-3xl font-black uppercase tracking-[-0.02em] text-foreground"
            >
                {t(lang, "projects.openSourceHeading")}
            </h2>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <div class="scrolling-section grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                openSourceProjects.map((project) => {
                    const TypeIcon = projectIcon[project.id] ?? Package;
                    return (
                        <article class="card group relative flex flex-col">
                            <ProjectPreview id={project.id} />
                            <div class="flex flex-1 flex-col border border-border bg-backgroundAlt p-5 sm:p-8 transition-colors duration-200 group-hover:border-accent group-focus-within:border-accent">
                                <div class="flex items-center justify-between gap-4">
                                    <span class="inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.2em] text-muted-foreground">
                                        <TypeIcon class="h-4 w-4 text-accent" aria-hidden="true" />
                                        {t(lang, `projects.openSource.${project.id}.type`)}
                                    </span>
                                    <span class="font-mono text-xs text-muted-foreground/70">
                                        {project.year}
                                    </span>
                                </div>

                                <h3 class="mt-5 text-2xl font-bold text-foreground">
                                    <a
                                        href={project.repo}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 transition-colors duration-200 group-hover:text-accent after:absolute after:inset-0"
                                    >
                                        {project.title}
                                        <ArrowUpRight
                                            class="h-5 w-5 text-muted-foreground transition-colors duration-200 group-hover:text-accent"
                                            aria-hidden="true"
                                        />
                                    </a>
                                </h3>

                                <p class="mt-4 text-sm leading-6 text-muted-foreground sm:leading-7">
                                    {t(lang, `projects.openSource.${project.id}.description`)}
                                </p>

                                {project.install && (
                                    <code
                                        tabindex="0"
                                        class="relative z-10 mt-6 block overflow-x-auto whitespace-nowrap border border-border bg-background px-4 py-3 font-mono text-xs text-foreground"
                                    >
                                        <span class="select-none text-muted-foreground/70">$ </span>
                                        {project.install}
                                    </code>
                                )}

                                <div class="mt-auto pt-8">
                                    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-5">
                                        <span class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground">
                                            <Scale class="h-4 w-4" aria-hidden="true" />
                                            <span class="sr-only">
                                                {t(lang, "projects.license")}:
                                            </span>
                                            {project.license}
                                        </span>
                                        {project.links.length > 0 && (
                                            <ul class="relative z-10 flex flex-wrap gap-4 list-none">
                                                {project.links.map((link) => {
                                                    const LinkIcon = linkIcon[link.kind];
                                                    return (
                                                        <li>
                                                            <a
                                                                href={link.href}
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-[0.15em] text-foreground underline-offset-4 transition-colors duration-200 hover:text-accent hover:underline"
                                                                aria-label={`${project.title}: ${t(lang, `projects.links.${link.kind}`)}`}
                                                            >
                                                                <LinkIcon
                                                                    class="h-4 w-4"
                                                                    aria-hidden="true"
                                                                />
                                                                {t(
                                                                    lang,
                                                                    `projects.links.${link.kind}`
                                                                )}
                                                            </a>
                                                        </li>
                                                    );
                                                })}
                                            </ul>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </section>
</section>
