---
import { ArrowUpRight } from "@lucide/astro";
import { Image } from "astro:assets";
import fsrLight from "../../images/mockups/fsr-mockup-light.png";
import fsrDark from "../../images/mockups/fsr-mockup-dark.png";
import ascii from "../../images/mockups/ascii-mockup.png";
import asciiMobile from "../../images/mockups/ascii-mockup-mobile.png";
import findora from "../../images/mockups/findora-mockup.png";
import stura from "../../images/mockups/stura-mockup.png";
import sturaMobile from "../../images/mockups/stura-mockup-mobile.png";
import { getLangFromUrl, t } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
---

<section class="py-16 sm:py-24 px-6 bg-backgroundAlt" aria-labelledby="projects-title">
    <div class="container">
        <div class="max-w-7xl mx-auto mb-12 sm:mb-16 lg:mb-24">
            <h2
                id="projects-title"
                class="text-4xl font-black uppercase leading-[1.1] tracking-[-0.02em] text-background-foreground sm:text-5xl"
            >
                {t(lang, "projects.title")}
            </h2>
            <div class="mt-4 h-1 w-24 bg-accent"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <!-- Project 01 -->
            <div class="md:col-span-4 md:mt-16 scrolling-section">
                <div class="aspect-[16/10] md:aspect-square overflow-hidden relative group">
                    <a
                        href="https://www.stura.tu-dresden.de/"
                        aria-label="Stura TU Dresden"
                        class="block h-full w-full"
                    >
                        <Image
                            src={stura}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 hidden md:block"
                        />
                        <Image
                            src={sturaMobile}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 md:hidden"
                        />
                    </a>
                    <div
                        class="absolute inset-0 bg-primary/8 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                    >
                    </div>
                </div>
                <div class="mt-8">
                    <span class="text-[0.6875rem] uppercase tracking-widest"
                        >Web Development / 2026</span
                    >
                    <h3 class="text-3xl font-bold mt-2">Stura TU Dresden</h3>
                </div>
            </div>
            <!-- Project 02 -->
            <div class="md:col-span-8 scrolling-section">
                <div class="aspect-[16/10] overflow-hidden relative group">
                    <a href="https://findora.de" aria-label="Findora" class="block h-full w-full">
                        <Image
                            src={findora}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                    </a>
                    <div
                        class="absolute inset-0 bg-primary/8 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                    >
                    </div>
                </div>
                <div class="mt-8 flex justify-between items-start">
                    <div>
                        <span class="text-[0.6875rem] uppercase tracking-widest"
                            >Web Development / 2026</span
                        >
                        <h3 class="text-3xl font-bold mt-2">Findora</h3>
                    </div>
                    <ArrowUpRight class="w-10 h-10 text-accent" />
                </div>
            </div>
            <!-- Project 03 -->
            <div class="md:col-span-8 md:mt-16 scrolling-section">
                <div class="aspect-[16/10] overflow-hidden relative group">
                    <a
                        href="https://ifsr.jannikmenzel.me"
                        aria-label="FSR Informatik TU Dresden"
                        class="block h-full w-full"
                    >
                        <Image
                            src={fsrLight}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 dark:hidden"
                        />
                        <Image
                            src={fsrDark}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 hidden dark:block"
                        />
                    </a>
                    <div
                        class="absolute inset-0 bg-primary/8 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                    >
                    </div>
                </div>
                <div class="mt-8 flex justify-between items-start">
                    <div>
                        <span class="text-[0.6875rem] uppercase tracking-widest"
                            >Web Design / 2025</span
                        >
                        <h3 class="text-3xl font-bold mt-2">FSR Informatik TU Dresden</h3>
                    </div>
                    <ArrowUpRight class="w-10 h-10 text-accent" />
                </div>
            </div>
            <!-- Project 04 -->
            <div class="md:col-span-4 md:mt-24 scrolling-section">
                <div class="aspect-[16/10] md:aspect-square overflow-hidden relative group">
                    <a
                        href="https://ascii.jannikmenzel.me"
                        aria-label="Ascii Dresden"
                        class="block h-full w-full"
                    >
                        <Image
                            src={ascii}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 hidden md:block"
                        />
                        <Image
                            src={asciiMobile}
                            alt=""
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 md:hidden"
                        />
                    </a>
                    <div
                        class="absolute inset-0 bg-primary/8 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                    >
                    </div>
                </div>
                <div class="mt-8">
                    <span class="text-[0.6875rem] uppercase tracking-widest">Web Design / 2026</span
                    >
                    <h3 class="text-3xl font-bold mt-2">Ascii Dresden</h3>
                </div>
            </div>
        </div>
    </div>
</section>
