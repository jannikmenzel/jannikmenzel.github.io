---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { getLocalizedPath } from "../i18n/ui";
import fontsStylesheet from "../styles/fonts.css?url";
import poppins400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2";
import poppins700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2";
import epilogue400 from "@fontsource/epilogue/files/epilogue-latin-400-normal.woff2";
import epilogue700 from "@fontsource/epilogue/files/epilogue-latin-700-normal.woff2";

const {
    title,
    description,
    keywords,
    lang,
    og = {},
    twitter = {},
    canonical,
    structuredData,
    noindex = false,
} = Astro.props;
const pageLang = lang ?? (Astro.url.pathname.startsWith("/en/") ? "en" : "de");

const basePath = getLocalizedPath("de", Astro.url.pathname);
const hreflangDe = new URL(basePath, Astro.site ?? "https://www.jannikmenzel.me").toString();
const hreflangEn = new URL(
    getLocalizedPath("en", basePath),
    Astro.site ?? "https://www.jannikmenzel.me"
).toString();

const siteTitle = "Jannik Menzel";
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const defaultDescription =
    "Offizielles Portfolio von Jannik Menzel – Informatikstudent an der TU Dresden. Entdecke Projekte, Blogbeiträge und Tools rund um Webentwicklung, Programmierung und Tech.";
const defaultKeywords =
    "Jannik Menzel, Informatik, TU Dresden, Portfolio, Webentwicklung, Programmieren, Softwareentwicklung, Blog, GitHub, DEV, Instagram, Projekte";

const structuredDataJson = structuredData ? JSON.stringify(structuredData) : undefined;
---

<style is:global>
    /* smooth theme transition */
    @media (min-width: 768px) {
        html,
        body,
        *:not(.object-cover, .transition-transform) {
            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                border-color 0.2s ease;
        }
    }
</style>

<html lang={pageLang} class="no-js">
    <head>
        <script is:inline>
            (() => {
                const storedLang = localStorage.getItem("language");
                const browserLang = navigator.language.toLowerCase();
                const isEnglishBrowser = browserLang.startsWith("en");
                const isOnRoot = window.location.pathname === "/";

                if (isOnRoot) {
                    if (storedLang === "en" || (!storedLang && isEnglishBrowser)) {
                        window.location.href = "/en";
                    }
                }
            })();
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="preload" href={fontsStylesheet} as="style" />
        <link rel="stylesheet" href={fontsStylesheet} />
        <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={epilogue400} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={epilogue700} as="font" type="font/woff2" crossorigin />
        <script is:inline>
            (() => {
                const html = document.documentElement;
                html.classList.remove("no-js");
                html.classList.add("js");

                const storageKey = "theme";
                const savedTheme = localStorage.getItem(storageKey);
                const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                const isDark = savedTheme ? savedTheme === "dark" : prefersDark;

                if (isDark) {
                    html.classList.add("dark");
                    html.style.colorScheme = "dark";
                } else {
                    html.classList.remove("dark");
                    html.style.colorScheme = "light";
                }
            })();
        </script>

        <meta name="referrer" content="strict-origin-when-cross-origin" />

        <script
            is:inline
            defer
            data-domain="jannikmenzel.me"
            src="https://stats.jannikmenzel.me/js/script.js"></script>

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#FFFFFF" />

        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        {noindex && <meta name="robots" content="noindex, follow" />}

        <meta name="description" content={description ?? defaultDescription} />
        <meta name="keywords" content={keywords ?? defaultKeywords} />
        {
            structuredDataJson && (
                <script is:inline type="application/ld+json" set:html={structuredDataJson} />
            )
        }

        <meta property="og:title" content={og.title ?? pageTitle} />
        <meta
            property="og:description"
            content={og.description ?? description ?? defaultDescription}
        />
        <meta property="og:type" content={og.type ?? "website"} />
        <meta property="og:url" content={og.url ?? "https://www.jannikmenzel.me"} />
        <meta
            property="og:image"
            content={og.image ?? "https://www.jannikmenzel.me/social-preview.png"}
        />

        <meta name="twitter:card" content={twitter.card ?? "summary_large_image"} />
        <meta name="twitter:title" content={twitter.title ?? og.title ?? pageTitle} />
        <meta
            name="twitter:description"
            content={twitter.description ?? og.description ?? description ?? defaultDescription}
        />
        <meta
            name="twitter:image"
            content={twitter.image ?? og.image ?? "https://www.jannikmenzel.me/social-preview.png"}
        />

        {
            canonical && (
                <>
                    <link rel="canonical" href={canonical} />
                    <link rel="alternate" hreflang="de" href={hreflangDe} />
                    <link rel="alternate" hreflang="en" href={hreflangEn} />
                    <link rel="alternate" hreflang="x-default" href={hreflangDe} />
                </>
            )
        }
    </head>

    <body class="min-h-screen flex flex-col">
        <Navbar />
        <main class="flex-1">
            <slot />
        </main>
        <Footer />
        <script>
            import "../scripts/scrolling-sections";
        </script>
        {
            import.meta.env.DEV && (
                <script is:inline>
                    console.log(`[Performance] Page: ${window.location.pathname}`);
                </script>
            )
        }
    </body>
</html>
