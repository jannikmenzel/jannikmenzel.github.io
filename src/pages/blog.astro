---
import Layout from "../layouts/Layout.astro";
import BlogCollection from "../components/blog/BlogCollection.astro";
import { t } from "../i18n/ui";

const lang = "de";
---

<Layout
    title={t(lang, "blog.title")}
    lang="de"
    description="Studienblog von Jannik Menzel: Artikel, Tutorials und wissenschaftliche Beiträge rund um Informatik, Studium und vieles mehr."
    keywords="Blog, Studium, Informatik, Webentwicklung, Artikel, Tutorials, Jannik Menzel"
    og={{
        title: `${t(lang, "blog.title")} – Jannik Menzel`,
        description:
            "Studienblog von Jannik Menzel: Artikel, Tutorials und wissenschaftliche Beiträge rund um Informatik, Studium und vieles mehr.",
        url: "https://www.jannikmenzel.me/blog/",
        image: "https://www.jannikmenzel.me/social-preview.png",
    }}
    twitter={{
        title: `${t(lang, "blog.title")} – Jannik Menzel`,
        description:
            "Studienblog von Jannik Menzel: Artikel, Tutorials und wissenschaftliche Beiträge rund um Informatik, Studium und vieles mehr.",
        image: "https://www.jannikmenzel.me/social-preview.png",
    }}
    canonical="https://www.jannikmenzel.me/blog/"
>
    <BlogCollection />
</Layout>
