---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.map((post: CollectionEntry<"blog">) => ({
        params: { slug: post.data.slug },
        props: { post },
    }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
---

<Layout
    title={post.data.seoTitle ?? post.data.title}
    description={post.data.teaser}
    lang="en"
    keywords={`Blog, Article, ${post.data.title}, Jannik Menzel, Computer Science, Web Development`}
    og={{
        title: post.data.title,
        description: post.data.teaser,
        url: `https://www.jannikmenzel.me/en/blog/${post.data.slug}/`,
        image: post.data.image?.src
            ? `https://www.jannikmenzel.me${post.data.image.src}`
            : "https://www.jannikmenzel.me/social-preview.png",
    }}
    twitter={{
        title: post.data.title,
        description: post.data.teaser,
        image: post.data.image?.src
            ? `https://www.jannikmenzel.me${post.data.image.src}`
            : "https://www.jannikmenzel.me/social-preview.png",
    }}
    canonical={`https://www.jannikmenzel.me/blog/${post.data.slug}/`}
    structuredData={{
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.teaser,
        image: post.data.image?.src
            ? `https://www.jannikmenzel.me${post.data.image.src}`
            : "https://www.jannikmenzel.me/social-preview.png",
        author: {
            "@type": "Person",
            name: "Jannik Menzel",
        },
        datePublished: post.data.date,
        url: `https://www.jannikmenzel.me/en/blog/${post.data.slug}/`,
    }}
>
    <article class="container p-4 sm:p-16 max-w-[1100px]">
        {
            post.data.image && (
                <Image
                    src={post.data.image}
                    alt={post.data.title}
                    loading={"eager"}
                    class="w-full max-h-120 mb-8 border border-border object-cover"
                />
            )
        }
        <div class="markdown-content">
            <Content />
        </div>
    </article>
</Layout>
