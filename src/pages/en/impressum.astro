---
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n/ui";
import addressSvg from "../../assets/contact/address-en.svg?raw";
import emailSvg from "../../assets/contact/email.svg?raw";

const lang = "en";
---

<Layout
    title={t(lang, "impressum.title")}
    lang="en"
    description="Imprint of Jannik Menzel: Information according to § 5 DDG, contact information and legal notices."
    keywords="Imprint, Contact, Legal, Jannik Menzel, DDG, Website"
    og={{
        title: `${t(lang, "impressum.title")} – Jannik Menzel`,
        description:
            "Imprint of Jannik Menzel: Information according to § 5 DDG, contact information and legal notices.",
        url: "https://www.jannikmenzel.me/en/impressum/",
        image: "https://www.jannikmenzel.me/social-preview.png",
    }}
    twitter={{
        title: "Legal Notice – Jannik Menzel",
        description: "Legal notice of the website of Jannik Menzel.",
        image: "https://www.jannikmenzel.me/social-preview.png",
    }}
    canonical="https://www.jannikmenzel.me/en/impressum/"
    structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: t(lang, "impressum.title"),
        description:
            "Imprint of Jannik Menzel: Information according to § 5 DDG, contact information and legal notices.",
        url: "https://www.jannikmenzel.me/en/impressum/",
    }}
>
    <main class="w-full container px-4 sm:px-16 mb-22 max-w-[1100px]">
        <!-- Header -->
        <header class="pt-20">
            <h1 class="text-center text-4xl sm:text-5xl font-bold font-display mb-4">
                {t(lang, "impressum.title")}
            </h1>
            <div class="h-1 w-24 bg-primary mx-auto"></div>
        </header>

        <!-- Content -->
        <section class="mb-6 sm:mb-6 pt-22">
            <h2 class="text-xl sm:text-2xl font-medium mb-2">{t(lang, "impressum.operator")}</h2>
            <p class="font-thin">Jannik Menzel</p>
        </section>

        <section class="mb-6 sm:mb-6">
            <h2 class="text-xl sm:text-2xl font-medium mb-2">{t(lang, "impressum.address")}</h2>
            <address class="font-thin not-italic">
                <span class="block [&>svg]:block" set:html={addressSvg} />
            </address>
        </section>

        <section class="mb-6 sm:mb-6">
            <h2 class="text-xl sm:text-2xl font-medium mb-2">{t(lang, "impressum.contact")}</h2>
            <p class="font-thin">
                {t(lang, "impressum.email")}
                <span class="inline-block align-top [&>svg]:block" set:html={emailSvg} />
            </p>
            <p class="font-thin">
                {t(lang, "impressum.website")}
                <a
                    href="https://www.jannikmenzel.me"
                    class="text-primary underline"
                    target="_blank"
                    rel="noopener">www.jannikmenzel.me</a
                >
            </p>
        </section>

        <section class="text-xs sm:text-sm text-muted-foreground">
            <p>
                {t(lang, "impressum.footerNote")}
            </p>
        </section>
    </main>
</Layout>
