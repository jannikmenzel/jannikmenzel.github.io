---
import Layout from "../../layouts/Layout.astro";
import PortfolioCollection from "../../components/portfolio/PortfolioCollection.astro";
import { t } from "../../i18n/ui";

const lang = "en";
---

<Layout
    title={t(lang, "portfolio.title")}
    lang="en"
    description="Portfolio of Jannik Menzel with selected web projects in design and development."
    keywords="Portfolio, Jannik Menzel, Web Development, Design, Projects, Dresden"
    og={{
        title: `${t(lang, "portfolio.title")} – Jannik Menzel`,
        description:
            "Portfolio of Jannik Menzel with selected web projects in design and development.",
        url: "https://www.jannikmenzel.me/en/portfolio/",
        image: "https://www.jannikmenzel.me/social-preview.png",
    }}
    twitter={{
        title: `${t(lang, "portfolio.title")} – Jannik Menzel`,
        description:
            "Portfolio of Jannik Menzel with selected web projects in design and development.",
        image: "https://www.jannikmenzel.me/social-preview.png",
    }}
    canonical="https://www.jannikmenzel.me/en/portfolio/"
    structuredData={{
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: t(lang, "portfolio.title"),
        description:
            "Portfolio of Jannik Menzel with selected web projects in design and development.",
        url: "https://www.jannikmenzel.me/en/portfolio/",
    }}
>
    <PortfolioCollection />
</Layout>
